# Environment Variables — RazorRecover AI

# Environment Profile
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Config
APP_NAME="RazorRecover AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=razorrecover_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/razorrecover_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/razorrecover_db

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Model Strategy Tiers (NVIDIA NIM Free LLM Models)
# Base URL for NVIDIA API: https://integrate.api.nvidia.com/v1
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL_PRIMARY=meta/llama-3.3-70b-instruct
AI_MODEL_COST=meta/llama-3.1-8b-instruct
AI_MODEL_ESCALATED=meta/llama-3.3-70b-instruct
NVIDIA_API_KEY=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


# Razorpay Test Mode Credentials (§10)
RAZORPAY_KEY_ID=rzp_test_key_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_placeholder

# Fernet Encryption Key (for encrypting Razorpay secrets at rest)
FERNET_KEY=gAAAAABl...place_valid_fernet_key_here...

# Auth JWT Config (§7)
JWT_SECRET=change-this-jwt-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
